rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{n} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 1;
      allow create: if request.auth != null && n.matches('[0-9]{15}') && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    match /chats/{c} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.uids;
      match /msgs/{m} {
        allow read, create, update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.uids;
      }
    }
  }
}
